{
  "name": "circo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 1204",
    "dev:all": "./scripts/dev.sh",
    "app:macos": "./scripts/build-macos-app.sh",
    "build": "next build",
    "start": "next start -p 1204",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:lines": "node scripts/check-lines.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check": "npm run check:lines && npm run check:i18n && npm run lint && npm run typecheck && npm run test",
    "db:init": "./scripts/db-init.sh",
    "db:shell": "sqlite3 data/circo.db",
    "data:export": "node scripts/export-circo-data.mjs",
    "models:download": "node scripts/download-translation-models.mjs",
    "mineru:prepare": "./scripts/prepare-mineru-macos.sh",
    "modules:package": "./scripts/build-external-modules.sh"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@huggingface/transformers": "^3.7.6",
    "@types/katex": "^0.16.8",
